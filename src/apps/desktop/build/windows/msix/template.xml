<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="otter"
        Arguments=""
        InstallLocation="C:\Program Files\Thomas Da Rocha\Otter">
    </Installer>
    <PackageInformation
        PackageName="Otter"
        PackageDisplayName="Otter"
        PublisherName="CN=Thomas Da Rocha"
        PublisherDisplayName="Thomas Da Rocha"
        Version="0.1.0.0"
        PackageDescription="A otter application">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.otter"
                Description="A otter application"
                DisplayName="Otter"
                ExecutableName="otter"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Otter</DisplayName>
            <PublisherDisplayName>Thomas Da Rocha</PublisherDisplayName>
            <Description>A otter application</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="otter.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
